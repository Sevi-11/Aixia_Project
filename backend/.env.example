# Copy to backend/.env and fill in. Never commit the real file.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True

# Postgres. Also holds the pgvector index, so one URL covers both the ORM and
# the vector store. On Supabase use the *session pooler* string (port 5432 on
# the pooler host) -- the direct connection is IPv6-only and unreachable from
# most PaaS providers.
DATABASE_URL=postgres://postgres:postgres@db:5432/aixia_db

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Needs the scheme, unlike ALLOWED_HOSTS. Required once DJANGO_DEBUG=False or
# admin login fails CSRF verification.
CSRF_TRUSTED_ORIGINS=

# Chat model.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.6-27b
# Answer sampling. Low but non-zero: high enough that "regenerate" produces a
# genuinely different phrasing, low enough that answers stay tied to the
# retrieved documents. Set to 0 for full determinism.
GROQ_TEMPERATURE=0.2
# Follow-up suggestions and conversation titles, where variety is the point.
GROQ_EXTRAS_TEMPERATURE=0.7
# Chunks retrieved per question. Raise it when the corpus holds several
# documents that overlap: near-identical chunks crowd the slots, and a fact
# living in only one chunk drops off the list entirely.
RETRIEVAL_K=5

# Embeddings for document retrieval. A separate provider from the chat model
# because Groq does not serve an embeddings endpoint. Key from
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key

# Object storage for uploaded PDFs (Supabase Storage speaks the S3 protocol).
# Leave AWS_STORAGE_BUCKET_NAME empty to keep uploads on local disk, which is
# what you want for development. Credentials come from the Supabase dashboard
# under Storage -> S3 connection, and are NOT your database password or anon
# key.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
